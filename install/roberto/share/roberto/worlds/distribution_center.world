<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin 
      filename="gz-sim-entity-factory-system" 
      name="gz::sim::systems::EntityFactory">
    </plugin>

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <scene>
      <shadows>false</shadows>
      <ambient>0.7 0.7 0.7 1</ambient> </scene>

    <include>
      <name>warehouse_walls</name>
      <uri>model://warehouse_walls</uri>
      <pose>0 0 0.001 0 0 0</pose> </include>

    <include><name>cl1</name><uri>model://WhiteChipChair</uri><pose>-4 4 0 0 0 0</pose></include>
    <include><name>cl2</name><uri>model://WhiteChipChair</uri><pose>-2.8 4 0 0 0 0</pose></include>
    <include><name>cl3</name><uri>model://WhiteChipChair</uri><pose>-1.6 4 0 0 0 0</pose></include>
    <include><name>cl4</name><uri>model://WhiteChipChair</uri><pose>-0.4 4 0 0 0 0</pose></include>
    <include><name>cl5</name><uri>model://WhiteChipChair</uri><pose>-4 5.2 0 0 0 0</pose></include>
    <include><name>cl6</name><uri>model://WhiteChipChair</uri><pose>-2.8 5.2 0 0 0 0</pose></include>
    <include><name>cl7</name><uri>model://WhiteChipChair</uri><pose>-1.6 5.2 0 0 0 0</pose></include>
    <include><name>cl8</name><uri>model://WhiteChipChair</uri><pose>-0.4 5.2 0 0 0 0</pose></include>
    <include><name>cl9</name><uri>model://WhiteChipChair</uri><pose>-4 6.4 0 0 0 0</pose></include>
    <include><name>cl10</name><uri>model://WhiteChipChair</uri><pose>-2.8 6.4 0 0 0 0</pose></include>

    <include><name>cr1</name><uri>model://WhiteChipChair</uri><pose>-4 -4 0 0 0 0</pose></include>
    <include><name>cr2</name><uri>model://WhiteChipChair</uri><pose>-2.8 -4 0 0 0 0</pose></include>
    <include><name>cr3</name><uri>model://WhiteChipChair</uri><pose>-1.6 -4 0 0 0 0</pose></include>
    <include><name>cr4</name><uri>model://WhiteChipChair</uri><pose>-0.4 -4 0 0 0 0</pose></include>
    <include><name>cr5</name><uri>model://WhiteChipChair</uri><pose>-4 -5.2 0 0 0 0</pose></include>
    <include><name>cr6</name><uri>model://WhiteChipChair</uri><pose>-2.8 -5.2 0 0 0 0</pose></include>
    <include><name>cr7</name><uri>model://WhiteChipChair</uri><pose>-1.6 -5.2 0 0 0 0</pose></include>
    <include><name>cr8</name><uri>model://WhiteChipChair</uri><pose>-0.4 -5.2 0 0 0 0</pose></include>

    <include><name>sl1</name><uri>model://WhiteChipChair</uri><pose>0.5 11 0 0 0 1.57</pose></include>
    <include><name>sl2</name><uri>model://WhiteChipChair</uri><pose>1.7 11 0 0 0 1.57</pose></include>
    <include><name>sl3</name><uri>model://WhiteChipChair</uri><pose>0.5 12.2 0 0 0 1.57</pose></include>
    <include><name>sl4</name><uri>model://WhiteChipChair</uri><pose>1.7 12.2 0 0 0 1.57</pose></include>

    <include><name>sr1</name><uri>model://WhiteChipChair</uri><pose>0.5 -11 0 0 0 -1.57</pose></include>
    <include><name>sr2</name><uri>model://WhiteChipChair</uri><pose>1.7 -11 0 0 0 -1.57</pose></include>
    <include><name>sr3</name><uri>model://WhiteChipChair</uri><pose>0.5 -12.2 0 0 0 -1.57</pose></include>
    <include><name>sr4</name><uri>model://WhiteChipChair</uri><pose>1.7 -12.2 0 0 0 -1.57</pose></include>

  </world>
</sdf>